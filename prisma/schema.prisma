generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TransactionHeader {
  id        String   @id @default(cuid())
  txId      String   @unique
  timestamp DateTime
  txValue   Decimal  @default(0)
  fee       Decimal  @default(0)
  block     BigInt?
  status    String?
  result    String?
  gasPrice  Decimal?
  gasUsed   Int?

  details TransactionDetail[]

  @@index([txId])
  @@index([timestamp])
}

model TransactionDetail {
  id           String   @id @default(cuid())
  key          String   @unique
  txId         String
  blockHash    String?
  fromHash     String
  toHash       String
  method       String
  timestamp    DateTime
  tokenAddress String
  tokenName    String
  tokenSymbol  String
  tokenType    String
  decimals     Int?
  value        Decimal
  txType       String
  notify       String?

  header TransactionHeader @relation(fields: [txId], references: [txId])

  @@index([key])
  @@index([timestamp])
  @@index([tokenAddress, timestamp])
  @@index([toHash, timestamp])
  @@index([tokenName])
  @@index([txType])
  @@index([fromHash])
}

model RedemptionTransactionHeader {
  id        String   @id @default(cuid())
  txId      String   @unique
  timestamp DateTime
  value     Decimal  @default(0)
  fee       Decimal  @default(0)
  block     BigInt?
  status    String?
  result    String?
  gasPrice  Decimal?
  gasUsed   Int?

  details RedemptionTransactionDetail[]

  @@index([txId])
  @@index([timestamp])
}

model RedemptionTransactionDetail {
  id           String   @id @default(cuid())
  key          String   @unique
  txId         String
  blockHash    String?
  fromHash     String
  method       String
  timestamp    DateTime
  toHash       String
  tokenAddress String
  tokenName    String
  tokenSymbol  String
  tokenType    String
  tokenId      String?

  header RedemptionTransactionHeader @relation(fields: [txId], references: [txId])

  @@index([key])
  @@index([timestamp])
  @@index([txId])
  @@index([tokenAddress, timestamp])
  @@index([fromHash, timestamp])
  @@index([toHash, timestamp])
}

model BatchJobLog {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String
  tokenName     String?
  tokenAddress  String?
  totalFetched  Int       @default(0)
  totalInserted Int       @default(0)
  totalUpdated  Int       @default(0)
  pagesScanned  Int       @default(0)
  stoppedReason String?
  error         String?

  @@index([startedAt])
  @@index([status])
}

model NFTInstance {
  id                     String
  isUnique               Boolean   @default(false)
  imageUrl               String?
  name                   String
  ownerHash              String
  tokenAddress           String
  normalizedTokenAddress String
  tokenValue             Decimal?
  type                   String?
  detailTH               String?
  conditionTH            String?
  category               String?
  availableDate          DateTime?
  expiredDate            DateTime?
  visible                Boolean   @default(true)
  isNotReplace           Boolean   @default(false)

  @@id([normalizedTokenAddress, id])
  @@index([tokenAddress])
}

model Wallet {
  id          String    @id @default(cuid())
  walletId    String    @unique
  timestamp   DateTime?
  notify      String?
  ICCYYN      Decimal   @default(0)
  FIT         Decimal   @default(0)
  TGT         Decimal   @default(0)
  INT         Decimal   @default(0)
  GRN         Decimal   @default(0)
  YYN         Decimal   @default(0)
  EVT         Decimal   @default(0)
  HLT         Decimal   @default(0)
  SCT         Decimal   @default(0)
  GVT         Decimal   @default(0)
  FIT_EXPIRED Decimal   @default(0)
  TGT_EXPIRED Decimal   @default(0)
  INT_EXPIRED Decimal   @default(0)
  GRN_EXPIRED Decimal   @default(0)
  YYN_EXPIRED Decimal   @default(0)
  EVT_EXPIRED Decimal   @default(0)
  HLT_EXPIRED Decimal   @default(0)
  SCT_EXPIRED Decimal   @default(0)
  GVT_EXPIRED Decimal   @default(0)

  @@index([walletId])
}

model Workspace {
  id               Int                  @id @default(autoincrement())
  name             String               @unique
  externalId       String?              @unique
  description      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tokenContracts   TokenContract[]
  addressContracts AddressContract[]
  adminUsers       AdminUserWorkspace[]
  fitivityData     FitivityData[]
  walletMappings   WalletMapping[]
}

model WalletMapping {
  id                      String    @id @default(cuid())
  userId                  String
  normalizedUserId        String
  walletAddress           String
  normalizedWalletAddress String
  workspaceId             Int
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([workspaceId, normalizedUserId, normalizedWalletAddress])
  @@index([workspaceId, normalizedUserId])
  @@index([workspaceId, normalizedWalletAddress])
}

model FitivityData {
  id          String    @id @default(cuid())
  userId      String
  metricType  String
  totalValue  Decimal   @db.Decimal(30, 12)
  count       Int
  unit        String
  date        DateTime  @db.Date
  window      String
  isCal       Boolean   @default(true)
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, metricType, date, workspaceId])
  @@index([workspaceId, date])
  @@index([metricType, date])
}

model FitivityImportJob {
  id                  String              @id @default(cuid())
  fileName            String
  status              String              @default("VALIDATING")
  progress            Int                 @default(0)
  processedRecords    Int                 @default(0)
  totalRecords        Int                 @default(0)
  newRecords          Int                 @default(0)
  duplicateRecords    Int                 @default(0)
  importedRecords     Int                 @default(0)
  overwrittenRecords  Int                 @default(0)
  overwriteDuplicates Boolean             @default(false)
  error               String?
  validationErrors    Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  rows                FitivityImportRow[]

  @@index([status, createdAt])
}

model FitivityImportRow {
  id                  BigInt            @id @default(autoincrement())
  jobId               String
  rowNumber           Int
  userId              String
  metricType          String
  totalValue          Decimal           @db.Decimal(30, 12)
  count               Int
  unit                String
  date                DateTime          @db.Date
  window              String
  workspaceId         Int
  workspaceExternalId String
  workspaceName       String
  status              String            @default("New")
  job                 FitivityImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([jobId, status, rowNumber])
}

model TokenContract {
  id                        String            @id @default(cuid())
  name                      String            @unique
  address                   String
  normalizedAddress         String            @unique
  symbol                    String?
  standard                  String?
  decimals                  Int?
  role                      String            @default("OTHER")
  active                    Boolean           @default(true)
  effectiveFrom             DateTime?
  effectiveTo               DateTime?
  workspaceId               Int
  workspace                 Workspace         @relation(fields: [workspaceId], references: [id])
  imageKey                  String?
  imageMimeType             String?
  chartColor                String            @default("#8B5CF6")
  aggregateAcrossWorkspaces Boolean           @default(false)
  chartAnnotations          ChartAnnotation[]

  @@index([workspaceId, active])
  @@index([role, active])
}

model AddressContract {
  id                        String     @id @default(cuid())
  name                      String     @unique
  address                   String
  normalizedAddress         String     @unique
  role                      String     @default("OTHER")
  version                   String?
  active                    Boolean    @default(true)
  effectiveFrom             DateTime?
  effectiveTo               DateTime?
  workspaceId               Int?
  workspace                 Workspace? @relation(fields: [workspaceId], references: [id])
  aggregateAcrossWorkspaces Boolean    @default(false)

  @@index([workspaceId, active])
  @@index([role, active])
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AdminUser {
  id                 String               @id @default(cuid())
  username           String               @unique
  name               String
  email              String?              @unique
  role               String               @default("admin")
  passwordHash       String
  active             Boolean              @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  annotationsCreated ChartAnnotation[]    @relation("AnnotationCreatedBy")
  annotationsUpdated ChartAnnotation[]    @relation("AnnotationUpdatedBy")
  roles              AdminUserRole[]
  workspaces         AdminUserWorkspace[]

  @@index([role])
  @@index([active])
}

model AdminRole {
  id               String                @id @default(cuid())
  name             String                @unique
  description      String?
  system           Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  users            AdminUserRole[]
  permissions      RoleMenuPermission[]
  chartPermissions RoleChartPermission[]
}

model AdminUserRole {
  adminUserId String
  roleId      String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@index([roleId])
}

model AdminUserWorkspace {
  adminUserId String
  workspaceId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([adminUserId, workspaceId])
  @@index([workspaceId])
}

model RoleMenuPermission {
  roleId  String
  menuKey String
  role    AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, menuKey])
  @@index([menuKey])
}

model RoleChartPermission {
  roleId   String
  chartKey String
  role     AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, chartKey])
  @@index([chartKey])
}

model ChartAnnotation {
  id                   String        @id @default(cuid())
  reportKey            String
  tokenContractId      String
  tokenContract        TokenContract @relation(fields: [tokenContractId], references: [id], onDelete: Cascade)
  workspaceSelectionId Int?
  date                 DateTime      @db.Date
  event                String        @db.VarChar(500)
  createdByAdminId     String
  createdByAdmin       AdminUser     @relation("AnnotationCreatedBy", fields: [createdByAdminId], references: [id])
  updatedByAdminId     String
  updatedByAdmin       AdminUser     @relation("AnnotationUpdatedBy", fields: [updatedByAdminId], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([reportKey, tokenContractId, workspaceSelectionId, date])
}
